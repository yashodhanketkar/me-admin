// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL") // uses connection pooling
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  picture   String?
  role      String
  username  String
  firstName String
  lastName  String
  password  String
  profile   Profile?
}

type Social {
  title    String
  username String?
  url      String
}

model research {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  title    String
  authors  String[]
  journal  String
  year     Int
  doi      String   @unique
  abstract String
}

model project {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  startYear   Int
  endYear     Int?
  description String
  url         String
}

model Experience {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  organization   String
  start          DateTime
  end            DateTime
  responsibility String
  Profile        Profile? @relation(fields: [profileId], references: [id])
  profileId      String?  @db.ObjectId
}

model Education {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  degree     String
  speciality String
  university String
  graduation String?
  grades     Float?
  project    String
  Profile    Profile? @relation(fields: [profileId], references: [id])
  profileId  String?  @db.ObjectId
}

model skills {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  level     Int?
  duration  String
  Profile   Profile? @relation(fields: [profileId], references: [id])
  profileId String?  @db.ObjectId
}

model Profile {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  user        User         @relation(fields: [userId], references: [id])
  userId      String       @unique @db.ObjectId
  description String?
  socails     Social[]
  experience  Experience[]
  education   Education[]
  skill       skills[]
}
